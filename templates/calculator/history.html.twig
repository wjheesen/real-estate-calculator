{% extends 'base.html.twig' %}

{% block title %}Calculation History - Real Estate Calculator{% endblock %}

{% block body %}
<div class="calculator-container p-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-history text-primary me-3"></i>
            Calculation History
        </h1>
        <a href="{{ path('real_estate_calculator') }}" class="btn btn-primary">
            <i class="fas fa-plus me-2"></i>New Calculation
        </a>
    </div>

    {% if calculations|length > 0 %}
        <div class="row">
            {% for calculation in calculations %}
                <div class="col-lg-4 col-md-6 mb-4">
                    <div class="card h-100 shadow-sm">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="fas fa-home text-primary me-2"></i>
                                Property Analysis
                            </h5>
                            <p class="card-text">
                                <strong>Purchase Price:</strong> ${{ calculation.purchasePrice|number_format(0) }}<br>
                                <strong>Down Payment:</strong> ${{ calculation.downPayment|number_format(0) }}<br>
                                <strong>Monthly Rent:</strong> ${{ calculation.expectedRentalIncome|number_format(2) }}
                            </p>
                            <div class="d-flex justify-content-between align-items-center">
                                <small class="text-muted">
                                    <i class="fas fa-calendar me-1"></i>
                                    {{ calculation.createdAt|date('M d, Y') }}
                                </small>
                                <div class="btn-group" role="group">
                                    <a href="{{ path('view_calculation', {'id': calculation.id}) }}" 
                                       class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <form method="post" action="{{ path('delete_calculation', {'id': calculation.id}) }}" 
                                          class="d-inline" onsubmit="return confirm('Are you sure you want to delete this calculation?')">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">
                                            <i class="fas fa-trash"></i>
                                        </button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% endfor %}
        </div>
    {% else %}
        <div class="text-center py-5">
            <i class="fas fa-calculator fa-5x text-muted mb-4"></i>
            <h3 class="text-muted mb-3">No calculations yet</h3>
            <p class="text-muted mb-4">Start by creating your first real estate investment analysis.</p>
            <a href="{{ path('real_estate_calculator') }}" class="btn btn-primary btn-lg">
                <i class="fas fa-plus me-2"></i>Create Your First Calculation
            </a>
        </div>
    {% endif %}
</div>
{% endblock %}
