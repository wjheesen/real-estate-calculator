{% extends 'base.html.twig' %}

{% block title %}Real Estate Calculator{% endblock %}

{% block body %}
<div class="calculator-container p-5">
    <div class="row">
        <div class="col-lg-6">
            <h1 class="mb-4">
                <i class="fas fa-calculator text-primary me-3"></i>
                Real Estate Investment Calculator
            </h1>
            <p class="lead text-muted mb-4">
                Analyze your real estate investment potential with comprehensive financial calculations.
            </p>

            {% if form %}
                {{ form_start(form, {'attr': {'class': 'needs-validation', 'novalidate': true}}) }}
            
                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.purchasePrice, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.purchasePrice, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.purchasePrice, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold mb-0" id="downPaymentLabel">Down Payment</label>
                            <div class="btn-group btn-group-sm toggle-group" role="group">
                                <input type="radio" class="btn-check" name="downPaymentMode" id="downPaymentDollar" value="dollar">
                                <label class="btn btn-outline-primary" for="downPaymentDollar">$</label>
                                <input type="radio" class="btn-check" name="downPaymentMode" id="downPaymentPercent" value="percent" checked>
                                <label class="btn btn-outline-primary" for="downPaymentPercent">%</label>
                            </div>
                        </div>
                        {{ form_widget(form.downPayment, {'attr': {'class': 'form-control form-control-lg', 'id': 'downPaymentInput'}}) }}
                        {{ form_errors(form.downPayment, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                        {{ form_widget(form.usePercentageForDownPayment, {'attr': {'style': 'display: none;'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.expectedRentalIncome, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.expectedRentalIncome, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.expectedRentalIncome, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.interestRate, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.interestRate, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.interestRate, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold mb-0" id="operatingExpensesLabel">Operating Expenses</label>
                            <div class="btn-group btn-group-sm toggle-group" role="group">
                                <input type="radio" class="btn-check" name="operatingExpensesMode" id="operatingExpensesDollar" value="dollar">
                                <label class="btn btn-outline-primary" for="operatingExpensesDollar">$</label>
                                <input type="radio" class="btn-check" name="operatingExpensesMode" id="operatingExpensesPercent" value="percent" checked>
                                <label class="btn btn-outline-primary" for="operatingExpensesPercent">%</label>
                            </div>
                        </div>
                        {{ form_widget(form.operatingExpenses, {'attr': {'class': 'form-control form-control-lg', 'id': 'operatingExpensesInput'}}) }}
                        {{ form_errors(form.operatingExpenses, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                        {{ form_widget(form.usePercentageForOpex, {'attr': {'style': 'display: none;'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <label class="form-label fw-bold mb-0" id="capitalExpendituresLabel">Capital Expenditures</label>
                            <div class="btn-group btn-group-sm toggle-group" role="group">
                                <input type="radio" class="btn-check" name="capitalExpendituresMode" id="capitalExpendituresDollar" value="dollar">
                                <label class="btn btn-outline-primary" for="capitalExpendituresDollar">$</label>
                                <input type="radio" class="btn-check" name="capitalExpendituresMode" id="capitalExpendituresPercent" value="percent" checked>
                                <label class="btn btn-outline-primary" for="capitalExpendituresPercent">%</label>
                            </div>
                        </div>
                        {{ form_widget(form.capitalExpenditures, {'attr': {'class': 'form-control form-control-lg', 'id': 'capitalExpendituresInput'}}) }}
                        {{ form_errors(form.capitalExpenditures, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                        {{ form_widget(form.usePercentageForCapex, {'attr': {'style': 'display: none;'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.rehabCosts, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.rehabCosts, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.rehabCosts, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.closingCosts, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.closingCosts, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.closingCosts, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.termYears, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.termYears, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.termYears, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.paymentsPerYear, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.paymentsPerYear, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.paymentsPerYear, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                    <div class="col-md-4 mb-3">
                        {{ form_label(form.appreciationRate, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.appreciationRate, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.appreciationRate, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.insuranceCost, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.insuranceCost, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.insuranceCost, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                    <div class="col-md-6 mb-3">
                        {{ form_label(form.propertyTaxes, null, {'label_attr': {'class': 'form-label fw-bold'}}) }}
                        {{ form_widget(form.propertyTaxes, {'attr': {'class': 'form-control form-control-lg'}}) }}
                        {{ form_errors(form.propertyTaxes, {'attr': {'class': 'invalid-feedback d-block'}}) }}
                    </div>
                </div>

                <div class="d-grid mb-3">
                    {{ form_widget(form.calculate, {'attr': {'class': 'btn btn-primary btn-lg'}}) }}
                </div>

                {{ form_rest(form) }}

                {{ form_end(form) }}
            {% else %}
                <div class="alert alert-info">
                    <h4>Real Estate Calculator</h4>
                    <p>The calculator form will be displayed here once the application is fully loaded.</p>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-6">
            {% if results %}
                <div class="results-card">
                    <h2 class="mb-4">
                        <i class="fas fa-chart-line me-2"></i>
                        Investment Analysis Results
                    </h2>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="metric-card">
                                <h6 class="mb-2">Monthly Cash Flow</h6>
                                <h3 class="mb-0">
                                    <span class="{% if results.monthlyCashFlow >= 0 %}text-success{% else %}text-danger{% endif %}">
                                        ${{ results.monthlyCashFlow|number_format(2) }}
                                    </span>
                                </h3>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="metric-card">
                                <h6 class="mb-2">Cash-on-Cash Return</h6>
                                <h3 class="mb-0">
                                    <span class="{% if results.cashOnCashReturn >= 0 %}text-success{% else %}text-danger{% endif %}">
                                        {{ results.cashOnCashReturn|number_format(2) }}%
                                    </span>
                                </h3>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="metric-card">
                                <h6 class="mb-2">Monthly Mortgage Payment</h6>
                                <h4 class="mb-0">${{ results.monthlyMortgagePayment|number_format(2) }}</h4>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="metric-card">
                                <h6 class="mb-2">Total Monthly Expenses</h6>
                                <h4 class="mb-0">${{ results.totalMonthlyExpenses|number_format(2) }}</h4>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-md-6">
                            <div class="metric-card">
                                <h6 class="mb-2">Future Property Value</h6>
                                <h4 class="mb-0">${{ results.futurePropertyValue|number_format(0) }}</h4>
                                <small>After {{ calculation.termYears }} years</small>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="metric-card">
                                <h6 class="mb-2">Total ROI</h6>
                                <h4 class="mb-0">
                                    <span class="{% if results.totalROI >= 0 %}text-success{% else %}text-danger{% endif %}">
                                        {{ results.totalROI|number_format(2) }}%
                                    </span>
                                </h4>
                            </div>
                        </div>
                    </div>

                    <div class="metric-card">
                        <h6 class="mb-2">Total Profit Projection</h6>
                        <h3 class="mb-0">
                            <span class="{% if results.totalProfit >= 0 %}text-success{% else %}text-danger{% endif %}">
                                ${{ results.totalProfit|number_format(0) }}
                            </span>
                        </h3>
                        <small>Over {{ calculation.termYears }} year period</small>
                    </div>

                    <div class="row mt-3">
                        <div class="col-12">
                            <h6>Monthly Income Analysis</h6>
                            <div class="row small">
                                <div class="col-6">Rental Income:</div>
                                <div class="col-6 text-end">${{ calculation.expectedRentalIncome|number_format(2) }}</div>
                                <div class="col-6">Operating Expenses:</div>
                                <div class="col-6 text-end">-${{ results.monthlyOperatingExpenses|number_format(2) }}</div>
                                <div class="col-6">Capital Expenditures:</div>
                                <div class="col-6 text-end">-${{ results.monthlyCapitalExpenditures|number_format(2) }}</div>
                                <div class="col-6">Insurance:</div>
                                <div class="col-6 text-end">-${{ results.monthlyInsurance|number_format(2) }}</div>
                                <div class="col-6">Property Taxes:</div>
                                <div class="col-6 text-end">-${{ results.monthlyPropertyTaxes|number_format(2) }}</div>
                                <div class="col-6">Mortgage Payment:</div>
                                <div class="col-6 text-end">-${{ results.monthlyMortgagePayment|number_format(2) }}</div>
                                <hr class="my-2">
                                <div class="col-6 fw-bold">Net Cash Flow:</div>
                                <div class="col-6 text-end fw-bold">
                                    <span class="{% if results.monthlyCashFlow >= 0 %}text-success{% else %}text-danger{% endif %}">
                                        ${{ results.monthlyCashFlow|number_format(2) }}
                                    </span>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="alert alert-info">
                    <i class="fas fa-info-circle me-2"></i>
                    <strong>Ready to Calculate!</strong>
                    <p class="mb-0 mt-2">Fill out the form on the left with your property details and financing information to get a comprehensive analysis of your real estate investment potential.</p>
                </div>

                <div class="card">
                    <div class="card-body">
                        <h5 class="card-title">
                            <i class="fas fa-lightbulb text-warning me-2"></i>
                            Investment Tips
                        </h5>
                        <ul class="list-unstyled mb-0">
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                Aim for positive cash flow from day one
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                Consider the 1% rule: monthly rent ≥ 1% of purchase price
                            </li>
                            <li class="mb-2">
                                <i class="fas fa-check text-success me-2"></i>
                                Factor in vacancy rates and maintenance costs
                            </li>
                            <li class="mb-0">
                                <i class="fas fa-check text-success me-2"></i>
                                Research local market trends and appreciation rates
                            </li>
                        </ul>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function() {
    // Configuration for fields with percentage/dollar toggles
    const toggleFields = [
        {
            name: 'downPayment',
            dollarLabel: 'Down Payment ($)',
            percentLabel: 'Down Payment (% of Purchase Price)',
            dollarPlaceholder: 'Enter dollar amount (e.g., 50000)',
            percentPlaceholder: 'Enter percentage (e.g., 20 for 20%)',
            checkboxId: 'real_estate_calculation_form_usePercentageForDownPayment'
        },
        {
            name: 'operatingExpenses',
            dollarLabel: 'Operating Expenses (Monthly $)',
            percentLabel: 'Operating Expenses (% of Rental Income)',
            dollarPlaceholder: 'Enter monthly dollar amount (e.g., 300)',
            percentPlaceholder: 'Enter percentage (e.g., 10 for 10%)',
            checkboxId: 'real_estate_calculation_form_usePercentageForOpex'
        },
        {
            name: 'capitalExpenditures',
            dollarLabel: 'Capital Expenditures (Monthly $)',
            percentLabel: 'Capital Expenditures (% of Rental Income)',
            dollarPlaceholder: 'Enter monthly dollar amount (e.g., 150)',
            percentPlaceholder: 'Enter percentage (e.g., 5 for 5%)',
            checkboxId: 'real_estate_calculation_form_usePercentageForCapex'
        }
    ];

    // Initialize each toggle field
    toggleFields.forEach(field => {
        const dollarRadio = document.getElementById(field.name + 'Dollar');
        const percentRadio = document.getElementById(field.name + 'Percent');
        const input = document.getElementById(field.name + 'Input');
        const label = document.getElementById(field.name + 'Label');
        const checkbox = document.getElementById(field.checkboxId);

        if (!dollarRadio || !percentRadio || !input || !label || !checkbox) {
            console.warn('Missing elements for field:', field.name);
            return;
        }

        // Function to update UI based on current state
        function updateFieldState() {
            const isPercent = percentRadio.checked;
            
            // Update label
            label.textContent = isPercent ? field.percentLabel : field.dollarLabel;
            
            // Update placeholder
            input.placeholder = isPercent ? field.percentPlaceholder : field.dollarPlaceholder;
            
            // Update hidden checkbox (this is what gets submitted with the form)
            checkbox.checked = isPercent;
            
            // Add visual feedback
            input.classList.toggle('percent-mode', isPercent);
            input.classList.toggle('dollar-mode', !isPercent);
        }

        // Function to sync radio buttons with checkbox state
        function syncRadioWithCheckbox() {
            if (checkbox.checked) {
                percentRadio.checked = true;
            } else {
                dollarRadio.checked = true;
            }
            updateFieldState();
        }

        // Add event listeners for radio buttons
        dollarRadio.addEventListener('change', function() {
            if (this.checked) {
                updateFieldState();
            }
        });
        
        percentRadio.addEventListener('change', function() {
            if (this.checked) {
                updateFieldState();
            }
        });

        // Initialize state based on checkbox default value
        syncRadioWithCheckbox();
    });
});
</script>

<style>
.toggle-group .btn {
    min-width: 45px;
    padding: 0.25rem 0.5rem;
}

.toggle-group .btn-check:checked + .btn {
    background-color: var(--bs-primary);
    border-color: var(--bs-primary);
    color: white;
}

.form-control.percent-mode {
    border-left: 3px solid #28a745;
}

.form-control.dollar-mode {
    border-left: 3px solid #17a2b8;
}

.percent-mode::before {
    content: '%';
    position: absolute;
    right: 10px;
    color: #28a745;
    font-weight: bold;
}

.dollar-mode::before {
    content: '$';
    position: absolute;
    left: 10px;
    color: #17a2b8;
    font-weight: bold;
}
</style>
{% endblock %}
