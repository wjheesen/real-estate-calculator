{% extends 'base.html.twig' %}

{% block title %}View Calculation - Real Estate Calculator{% endblock %}

{% block body %}
<div class="calculator-container p-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1>
            <i class="fas fa-chart-bar text-primary me-3"></i>
            Calculation Results
        </h1>
        <div>
            <a href="{{ path('calculation_history') }}" class="btn btn-secondary me-2">
                <i class="fas fa-arrow-left me-2"></i>Back to History
            </a>
            <a href="{{ path('real_estate_calculator') }}" class="btn btn-primary me-2">
                <i class="fas fa-plus me-2"></i>New Calculation
            </a>
            <form method="post" action="{{ path('delete_calculation', {'id': calculation.id}) }}" style="display: inline;">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Are you sure you want to delete this calculation?')">
                    <i class="fas fa-trash me-2"></i>Delete Calculation
                </button>
            </form>
        </div>
    </div>

    <div class="row">
        <div class="col-lg-6">
            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-home me-2"></i>Property Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Purchase Price</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ calculation.purchasePrice|number_format(2) }}
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Down Payment</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ results.downPaymentAmount|number_format(2) }}
                                {% if calculation.usePercentageForDownPayment %}
                                    <small class="text-muted">({{ calculation.downPayment }}% of purchase price)</small>
                                {% endif %}
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Rehab Costs</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ calculation.rehabCosts|number_format(2) }}
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Closing Costs</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ calculation.closingCosts|number_format(2) }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card mb-4">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-percent me-2"></i>Financing Details
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Interest Rate</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                {{ (calculation.interestRate * 100)|number_format(3) }}%
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Term (Years)</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                {{ calculation.termYears }}
                            </div>
                        </div>
                        <div class="col-md-4 mb-3">
                            <label class="form-label fw-bold">Payments/Year</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                {{ calculation.paymentsPerYear }}
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header">
                    <h5 class="mb-0">
                        <i class="fas fa-dollar-sign me-2"></i>Income & Expenses
                    </h5>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Monthly Rental Income</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ calculation.expectedRentalIncome|number_format(2) }}
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Annual Insurance</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ calculation.insuranceCost|number_format(2) }}
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Annual Property Taxes</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                ${{ calculation.propertyTaxes|number_format(2) }}
                            </div>
                        </div>
                        <div class="col-md-6 mb-3">
                            <label class="form-label fw-bold">Appreciation Rate</label>
                            <div class="form-control-plaintext bg-light rounded p-2">
                                {{ (calculation.appreciationRate * 100)|number_format(3) }}%
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="results-card">
                <h2 class="mb-4">
                    <i class="fas fa-chart-line me-2"></i>
                    Investment Analysis Results
                </h2>

                <div class="row">
                    <div class="col-md-6">
                        <div class="metric-card">
                            <h6 class="mb-2">Monthly Cash Flow</h6>
                            <h3 class="mb-0">
                                <span class="{% if results.monthlyCashFlow >= 0 %}text-success{% else %}text-danger{% endif %}">
                                    ${{ results.monthlyCashFlow|number_format(2) }}
                                </span>
                            </h3>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="metric-card">
                            <h6 class="mb-2">Cash-on-Cash Return</h6>
                            <h3 class="mb-0">
                                <span class="{% if results.cashOnCashReturn >= 0 %}text-success{% else %}text-danger{% endif %}">
                                    {{ results.cashOnCashReturn|number_format(2) }}%
                                </span>
                            </h3>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="metric-card">
                            <h6 class="mb-2">Monthly Mortgage Payment</h6>
                            <h4 class="mb-0">${{ results.monthlyMortgagePayment|number_format(2) }}</h4>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="metric-card">
                            <h6 class="mb-2">Total Monthly Expenses</h6>
                            <h4 class="mb-0">${{ results.totalMonthlyExpenses|number_format(2) }}</h4>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6">
                        <div class="metric-card">
                            <h6 class="mb-2">Future Property Value</h6>
                            <h4 class="mb-0">${{ results.futurePropertyValue|number_format(0) }}</h4>
                            <small>After {{ calculation.termYears }} years</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="metric-card">
                            <h6 class="mb-2">Total ROI</h6>
                            <h4 class="mb-0">
                                <span class="{% if results.totalROI >= 0 %}text-success{% else %}text-danger{% endif %}">
                                    {{ results.totalROI|number_format(2) }}%
                                </span>
                            </h4>
                        </div>
                    </div>
                </div>

                <div class="metric-card">
                    <h6 class="mb-2">Total Profit Projection</h6>
                    <h3 class="mb-0">
                        <span class="{% if results.totalProfit >= 0 %}text-success{% else %}text-danger{% endif %}">
                            ${{ results.totalProfit|number_format(0) }}
                        </span>
                    </h3>
                    <small>Over {{ calculation.termYears }} year period</small>
                </div>

                <div class="row mt-3">
                    <div class="col-12">
                        <h6>Monthly Income Analysis</h6>
                        <div class="row small">
                            <div class="col-6">Rental Income:</div>
                            <div class="col-6 text-end">${{ calculation.expectedRentalIncome|number_format(2) }}</div>
                            <div class="col-6">Operating Expenses:</div>
                            <div class="col-6 text-end">-${{ results.monthlyOperatingExpenses|number_format(2) }}</div>
                            <div class="col-6">Capital Expenditures:</div>
                            <div class="col-6 text-end">-${{ results.monthlyCapitalExpenditures|number_format(2) }}</div>
                            <div class="col-6">Insurance:</div>
                            <div class="col-6 text-end">-${{ results.monthlyInsurance|number_format(2) }}</div>
                            <div class="col-6">Property Taxes:</div>
                            <div class="col-6 text-end">-${{ results.monthlyPropertyTaxes|number_format(2) }}</div>
                            <div class="col-6">Mortgage Payment:</div>
                            <div class="col-6 text-end">-${{ results.monthlyMortgagePayment|number_format(2) }}</div>
                            <hr class="my-2">
                            <div class="col-6 fw-bold">Net Cash Flow:</div>
                            <div class="col-6 text-end fw-bold">
                                <span class="{% if results.monthlyCashFlow >= 0 %}text-success{% else %}text-danger{% endif %}">
                                    ${{ results.monthlyCashFlow|number_format(2) }}
                                </span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="text-center mt-4">
        <small class="text-muted">
            <i class="fas fa-calendar me-1"></i>
            Calculated on {{ calculation.createdAt|date('F j, Y \\a\\t g:i A') }}
        </small>
    </div>
</div>
{% endblock %}
